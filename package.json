{
  "name": "fragments",
  "version": "0.10.0",
  "description": "Fragments back-end API",
  "scripts": {
    "test:watch": "jest -c jest.config.js --runInBand --watch --",
    "test": "jest -c jest.config.js --runInBand --",
    "coverage": "jest -c jest.config.js --runInBand --coverage",
    "lint": "eslint \"./src/**/*.js\" \"tests/**/*.js\"",
    "start": "node src/index.js",
    "dev": "FRAGMENTS_LOG_LEVEL=debug nodemon ./src/index.js --watch src",
    "debug": "FRAGMENTS_LOG_LEVEL=debug nodemon --inspect=0.0.0.0:9229 ./src/index.js --watch src",
    "test:integration": "hurl --test --glob \"tests/integration/**/*.hurl\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BitMyTongue/fragments.git"
  },
  "author": "Aaron Ngo",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@orangeopensource/hurl": "^7.1.7",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "prettier": "3.7.4",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1024.0",
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/lib-dynamodb": "^3.1024.0",
    "aws-jwt-verify": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-auth": "^4.2.1",
    "http-auth-passport": "^1.0.7",
    "markdown-it": "^14.1.1",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "stoppable": "^1.1.0"
  }
}
